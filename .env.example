# Copia questo file in .env e inserisci le tue chiavi (il file .env non va mai committato)

# Modello nel formato "provider:nome-modello"
MODEL=openai:gpt-5.4
OPENAI_API_KEY=sk-...

# Per usare Anthropic: pip install langchain-anthropic, poi
# MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# Tracing LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=helpdesk
# Per account LangSmith in regione EU, decommenta:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
